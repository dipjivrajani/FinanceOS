# ============================================================
# FinanceOS - Backend Environment Configuration Template
# Copy this file to .env and configure your local or production values.
# NEVER commit your actual .env file with secrets or keys to Git.
# ============================================================

# Server Port (default 5000)
PORT=5000

# MongoDB Connection URI (Required)
# Example: mongodb://127.0.0.1:27017/financeos or MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/financeos

# JWT Secret Key for Session Authentication (Required)
JWT_SECRET=your_jwt_secret_key_here

# Email Notification Delivery Service (Gmail SMTP for OTP & Alerts)
# Requires a 16-character Google App Password with 2FA enabled on your Google account
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Default Administrator Email (Optional)
ADMIN_EMAIL=admin@financeos.com

# ------------------------------------------------------------
# Google Gemini AI Integration (Required for Live AI Adviser)
# ------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com
# Supported models: gemini-2.5-flash (recommended), gemini-2.0-flash, gemini-1.5-flash
# If not configured, the system reports GEMINI_API_KEY_MISSING and allows retry.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# Live Indian Market Data Feeds (Optional / Configurable)
# ------------------------------------------------------------
# Gold/Silver bullion live rates (GoldAPI.io):
# Free tier provides 100 requests/month. If omitted, the engine uses
# Yahoo Finance GC=F spot price or public published bullion rates.
GOLDAPI_KEY=

# Equities (NIFTY 50, BSE Sensex) and Forex (USD/INR):
# FinanceOS fetches live quotes via Yahoo Finance query endpoints (^NSEI, ^BSESN, INR=X).
# For exchange-licensed direct real-time feeds (paid tick-by-tick), configure authorized vendor keys below:
NSE_API_KEY=
BSE_API_KEY=

# Market Data Cache TTL (in seconds, default 300 = 5 minutes):
# Balances provider rate limits with data freshness.
MARKET_DATA_CACHE_TTL_SECONDS=300

# Node Environment (development | production)
NODE_ENV=development
